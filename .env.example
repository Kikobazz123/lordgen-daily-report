# Copy to .env for local runs. NEVER commit .env.
# For the deployed task, set the same variables in the Trigger.dev dashboard
# (project -> Environment Variables). The orchestrator refuses to run if any
# of the eight below are missing.

# --- Research + drafting ------------------------------------------------------
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""

# --- Gmail API (OAuth Desktop-app client) -------------------------------------
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""        # mint with: npm run gmail-oauth-setup
GMAIL_SENDER_EMAIL="you@example.com"
REPORT_RECIPIENT_EMAIL="you@example.com"

# --- ClickUp -----------------------------------------------------------------
CLICKUP_API_TOKEN=""

# --- Local tooling only -------------------------------------------------------
# Used by scripts/test-trigger.ts to fire tasks from your machine.
TRIGGER_SECRET_KEY=""

# Loopback redirect for scripts/gmail-oauth-setup.ts. Must be registered as an
# authorized redirect URI on the Google OAuth client.
OAUTH_REDIRECT_URI="http://127.0.0.1:53682/callback"
